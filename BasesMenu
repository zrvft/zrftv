	local nx, ny = pos.X, pos.Y
	w = w or charW
	if y < ny then
		ny = y - lineH
	elseif y + lineH * 2 > ny + vh then
		ny = y + lineH * 2 - vh
	end
	if x < nx then
		nx = x - charW * 4
	elseif x + w + charW * 2 > nx + vw then
		nx = x + w + charW * 2 - vw
	end
	nx, ny = math.max(0, nx), math.max(0, ny)
