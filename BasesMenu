function highlight(src)
	local out, n = {}, 0
	local len = #src
	local i = 1
	local prevWord, lastSig = "", ""
	local function add(s)
		n += 1
		out[n] = s
	end
	local function tok(color, s)
		add('<font color="' .. color .. '">' .. esc(s) .. "</font>")
	end

	while i <= len do
		local c = src:sub(i, i)
		if c == "-" and src:sub(i + 1, i + 1) == "-" then
			local eq = src:match("^%-%-%[(=*)%[", i)
			local e
			if eq then
				local _, ce = src:find("]" .. eq .. "]", i + 4 + #eq, true)
				e = ce or len
			else
				local nl = src:find("\n", i, true)
				e = nl and (nl - 1) or len
			end
			tok(HL.comment, src:sub(i, e))
			i = e + 1
			lastSig = ""
		elseif c == '"' or c == "'" then
			local j = i + 1
			while j <= len do
				local d = src:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == c or d == "\n" then
					break
				else
					j += 1
				end
			end
			local e
			if src:sub(j, j) == c then
				e = j
			else
				e = math.min(j - 1, len)
			end
			tok(HL.string, src:sub(i, e))
			i = e + 1
			lastSig = c
		elseif c == "[" and src:match("^%[=*%[", i) then
			local eq = src:match("^%[(=*)%[", i)
			local _, ce = src:find("]" .. eq .. "]", i + 2 + #eq, true)
			local e = ce or len
			tok(HL.string, src:sub(i, e))
			i = e + 1
			lastSig = "]"
		elseif c:match("%d") or (c == "." and src:sub(i + 1, i + 1):match("%d")) then
			local s = src:match("^0[xX][%x_]+", i) or src:match("^0[bB][01_]+", i)
			if not s then
				s = src:match("^%d[%d_]*%.?[%d_]*", i) or src:match("^%.%d[%d_]*", i)
				if s:sub(-1) == "." and src:sub(i + #s, i + #s) == "." then
					s = s:sub(1, -2)
				end
				local ex = src:match("^[eE][%+%-]?%d+", i + #s)
				if ex then
					s = s .. ex
				end
			end
			tok(HL.number, s)
			i += #s
			lastSig = "0"
		elseif c:match("[%a_]") then
			local w = src:match("^[%a_][%w_]*", i)
			local j = i + #w
			local member = (lastSig == "." or lastSig == ":")
			local color
			if member then
				if src:match("^%s*%(", j) then
					color = HL.func
				end
			elseif keywords[w] then
				color = HL.keyword
			elseif consts[w] then
				color = HL.const
			elseif prevWord == "function" or src:match("^%s*%(", j) then
				color = builtins[w] and HL.builtin or HL.func
			elseif builtins[w] then
				color = HL.builtin
			end
			if color then
				tok(color, w)
			else
				add(w)
			end
			prevWord = w
			lastSig = w:sub(-1)
			i = j
		elseif c:match("%s") then
			local ws = src:match("^%s+", i)
			add(ws)
			i += #ws
		else
			local run = src:match("^[%+%*/%%%^#=~<>]+", i)
			if run then
				tok(HL.op, run)
				i += #run
				lastSig = run:sub(-1)
			elseif c == "-" then
				tok(HL.op, "-")
				i += 1
				lastSig = "-"
			else
				add(esc(c))
				lastSig = c
				i += 1
			end
		end
	end
	return table.concat(out)
end

function normalize(src)
	src = tostring(src or "")
	src = src:gsub("\r\n", "\n")
	src = src:gsub("\r", "\n")
	src = src:gsub("\226\128[\168\169]", "\n")
	src = src:gsub("\t", string.rep(" ", settings.tabSize))
	return src
end

function sanitize(name)
	name = tostring(name or "")
	name = name:gsub("[^%w%s%-%_%.%(%)]", "")
	name = name:match("^%s*(.-)%s*$")
	if name == "" then
		name = "Unnamed"
	end
	return name:sub(1, 40)
end

