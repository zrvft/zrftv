	local newName = uniqueName(sanitize(raw), i)
	if newName ~= d.name then
		local old = d.name
		d.name = newName
		if hasFS and scriptsLoaded then
			pcall(writefile, scriptPath(newName), d.source)
			if old:lower() ~= newName:lower() then
				pcall(delfile, scriptPath(old))
			end
			d.dirty = false
		elseif hasFS then
			d.dirty = true
